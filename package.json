{
  "name": "smileflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "db:up": "docker compose -f docker/docker-compose.yml up -d postgres redis",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "turbo db:migrate",
    "db:seed": "turbo db:seed",
    "db:generate": "turbo db:generate"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "@nestjs/throttler": "^5.2.0",
    "helmet": "^7.2.0"
  }
}
