# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smileflow?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Billing — applied to invoice subtotals server-side (0.08 = 8%)
INVOICE_TAX_RATE=0.08

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# File Storage (S3-compatible)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=smileflow-files
S3_ENDPOINT=http://localhost:9000

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@smileflow.com

# SMS delivery. Selected by exact name: only "twilio" reaches the real provider,
# because a typo in this variable would otherwise start texting real people.
# "logging" records that a message would have gone out and sends nothing; an
# unset variable selects it too. Any other value — including the "mock" this
# line used to carry, which never had an implementation behind it — fails
# closed, so a misconfigured deployment sends nothing rather than pretending to.
SMS_PROVIDER=logging

# Voice agent
VOICE_AGENT_ENABLED=false
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional. Both are read by the Anthropic SDK itself, never by this codebase,
# so the key is never handled — and therefore never logged — by application
# code. Leave them unset to talk to Anthropic directly.
#
# Set them to route the same Messages API through a compatible gateway. The
# base URL carries no /v1: the SDK appends /v1/messages itself. A gateway
# needs a vendor-prefixed model id, which is what VOICE_AGENT_MODEL is for.
# The default model is the one the system prompt and token budget were tuned
# against, so overriding it changes how the agent behaves.
#
#   ANTHROPIC_BASE_URL=https://openrouter.ai/api
#   VOICE_AGENT_MODEL=anthropic/claude-sonnet-4.5
ANTHROPIC_BASE_URL=
VOICE_AGENT_MODEL=

# Which transport answers the agent. "anthropic" (default) uses the Anthropic
# SDK, optionally pointed at a compatible gateway by ANTHROPIC_BASE_URL above.
# "gemini" talks to Google directly and needs Gemini_API_Key; the model is then
# a Google id such as gemini-3-flash-preview. Selection is explicit so a
# deployment holding both keys cannot change provider by accident.
VOICE_AGENT_PROVIDER=anthropic
Gemini_API_Key=

# Voice agent — browser voice.
# Default-deny: anything other than exactly "true" leaves the public voice
# page and the /voice WebSocket inert. The server closes the socket without
# issuing a session, so a disabled deployment accumulates nothing from probing.
VOICE_BROWSER_ENABLED=false
NEXT_PUBLIC_VOICE_BROWSER_ENABLED=false
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:3001/voice

# Speech providers. Server-side only — never sent to the browser, never
# embedded in a page, never minted into a client token. Missing keys fail
# closed: speech recognition reports stt_unavailable and replies are delivered
# as text instead of audio.
DEEPGRAM_API_KEY=your-deepgram-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional. Defaults to a clear, unhurried stock voice.
ELEVENLABS_VOICE_ID=

# Browser origins allowed to open a voice socket. Comma separated. Also used
# for HTTP CORS — one list, because CORS does not cover WebSocket handshakes
# and two lists drift apart.
FRONTEND_URL=http://localhost:3000

# Voice session, idempotency and auth-ticket state all live in Redis, so any
# instance can serve any request and sticky routing is not required. This is
# only a declared count, used to warn when a deployment looks multi-instance
# before the state it depends on is reachable.
APP_INSTANCES=1

# ── Voice agent — phone channel (Twilio) ────────────────────────────────────
#
# Default-deny, like the browser widget. An inbound call is a public entry
# point that costs money per minute, so only the exact string "true" enables
# it; absent or approximate is not consent. With it off, the webhook answers
# every call with a TwiML <Reject/> and no media stream is ever opened.
VOICE_PHONE_ENABLED=false

# Server-side only. Never sent to the browser, never embedded in a page, never
# minted into a client token — there is deliberately no NEXT_PUBLIC_ variant of
# any value below. Missing credentials fail closed: the webhook rejects calls
# and SMS sending refuses, rather than the application refusing to start.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number codes are sent from.
TWILIO_PHONE_NUMBER=

# The URL Twilio signatures are validated against, and it must match the URL
# Twilio actually calls EXACTLY — scheme, host and path. Twilio computes its
# signature over the URL it requested, so validating against anything else
# fails every request with a 403 that looks exactly like an attack. Never
# derived from the request's own Host header: behind a proxy that is
# attacker-influenced, and a signature whose input an attacker chooses is not a
# signature.
TWILIO_VOICE_WEBHOOK_URL=

# Hashes one-time codes before they are stored, and hashes phone numbers into
# Redis key names. Required whenever the phone channel is on: without it, code
# verification refuses rather than falling back to a predictable hash. Generate
# with `openssl rand -hex 32` and rotate it like any other secret.
OTP_HMAC_SECRET=
